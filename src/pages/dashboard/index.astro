---
import MainLayout from "../../layouts/authenticated.astro";
import { Authenticator } from '@aws-amplify/ui-react';
import FavoritesList from "../../components/account/favorites-list";
import ProfileHeader from "../../components/account/profile-header";
import AuthView from '../../components/AuthView';
---

<AuthView client:load>
<Authenticator.Provider>
  <MainLayout title="Berklee Open: Dashboard" cssClass="dashboard">
    <div class="container mx-auto px-4 flex items-start justify-center mb-16">
      <ProfileHeader isDashboard={true} isAccountPage={false} client:load />
    </div>
    <div class="container mx-auto px-4">
      <FavoritesList client:load />
    </div>
  </MainLayout>
</Authenticator.Provider>
</AuthView>
