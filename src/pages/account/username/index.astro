---
import MainLayout from "../../../layouts/main.astro";
import AccountSettingsWrapper from "../../../components/account/account-settings-wrapper";
import UsernameChangeForm from "../../../components/account/username-change-form";
import '@aws-amplify/ui-react/styles.css';
---

<MainLayout title={`Berklee Open: Edit Username`} showHeader={true} cssClass="account">
  <AccountSettingsWrapper client:load currentPage="/account/username">
    <div class="flex gap-20">
      <div class="w-full">
        <h2 class="text-2xl font-bold mb-6">Edit Username</h2>
        <UsernameChangeForm client:load />
      </div>
    </div>
  </AccountSettingsWrapper>
</MainLayout>