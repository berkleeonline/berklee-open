---
import { AccountSettings } from '@aws-amplify/ui-react';
import MainLayout from "../../../layouts/main.astro";
import AccountSettingsWrapper from "../../../components/account/account-settings-wrapper";
import AuthView from '../../../components/AuthView';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import {faMessageMusic} from '@fortawesome/pro-light-svg-icons';
import '@aws-amplify/ui-react/styles.css';
---

<AuthView client:load>
<MainLayout title={`Berklee Open: Delete User`} showHeader={true} cssClass="account">
  <AccountSettingsWrapper client:load currentPage="/account/delete">
    <div class="flex gap-20">
      <div class="w-full">
        <h1 class="text-2xl font-bold mb-8 flex"><FontAwesomeIcon icon={faMessageMusic} className="w-6 mr-3 mt-1" /> Goodbye for now.</h1>
        <p class="mb-4">You'll always be part of the Berklee Open family.</p><p class="mb-12">If you ever feel like rejoining, just tune in and Berklee Open will be here, ready to help you and your students hit the right notes.</p>
        <AccountSettings.DeleteUser client:load
          displayText={{
          deleteAccountText: 'Delete the account',
          cancelButtonText: 'Cancel',
          confirmDeleteButtonText: 'I understand, delete my account',
          warningText: 'Your account and associated data will be deleted. This action cannot be undone.'
        }}
      />
      </div>
    </div>
  </AccountSettingsWrapper>
</MainLayout>
</AuthView>