---
import { Buffer } from 'buffer';
import fs from 'fs';
import path from 'path';
import { generate } from './generate';
import AuthView from '../../components/AuthView';
import PdfLayout from '../../layouts/pdf.astro';
import { contentfulClient } from '../../lib/contentful';

// API function to fetch entry by ID
const fetchEntryById = async (id) => {
  try {
    const entry = await contentfulClient.getEntry(id);
    return entry;
  } catch (error) {
    console.warn(`Failed to fetch entry ${id}: ${error.message}`);
    return null;
  }
};

// Fetch and resolve lesson sections and instructions
const fetchAndResolveSections = async (sections) => {
  if (!sections || !Array.isArray(sections)) return [];

  const resolvedSections = await Promise.all(
    sections.map(async (section) => {
      try {
        let interactiveContent = [];
        let instructions = [];

        // Only try to fetch if we have a valid ID
        if (section?.fields?.interactiveContent?.sys?.id) {
          const interactiveContentEntry = await fetchEntryById(section.fields.interactiveContent.sys.id);
          
          if (interactiveContentEntry) {
            interactiveContent = interactiveContentEntry.fields?.slides || [];
            instructions = interactiveContentEntry.fields?.instructions || [];
          }
        }

        return {
          ...section,
          fields: {
            ...section.fields,
            interactiveContent,
            instructions,
          },
        };
      } catch (error) {
        console.warn(`Failed to resolve section: ${error.message}`);
        // Return the original section with empty arrays if resolution fails
        return {
          ...section,
          fields: {
            ...section.fields,
            interactiveContent: [],
            instructions: []
          }
        };
      }
    })
  );

  return resolvedSections.filter(Boolean); // Remove any null sections
};

// Fetch the lesson data
const fetchLessonData = async (lessonId) => {
  try {
    const lessonEntry = await contentfulClient.getEntry(lessonId);
    const lessonFields = lessonEntry.fields;

    const resolvedSections = await fetchAndResolveSections(lessonFields.lesson_sections || []);
    return {
      fields: lessonFields,
      sections: resolvedSections,
    };
  } catch (error) {
    console.error(`Failed to fetch lesson data for ${lessonId}: ${error.message}`);
    // Return a minimal valid structure
    return {
      fields: {},
      sections: []
    };
  }
};

// Define getStaticPaths for dynamic routes
export async function getStaticPaths() {
  const pdfs = await contentfulClient.getEntries({
    content_type: "lesson",
  });

  return pdfs.items.map((pdf) => ({
    params: { pdf: pdf.sys.id },
  }));
}

// Get the lesson ID from the URL params
const { pdf: lessonId } = Astro.params;

// Fetch the lesson data
const pdfProps = await fetchLessonData(lessonId);

// Generate the PDF with props
const dataRaw = await generate(pdfProps, lessonId);
const data = dataRaw ? dataRaw.toString('base64') : null;
const dataUrl = data ? `data:application/pdf;base64,${data}` : null;
---

<PdfLayout cssClass="pdf-page">
  <AuthView client:load>
    {dataUrl ? (
      <iframe src={dataUrl} style="height: 100vh; width: 100vw;" />
    ) : (
      <></>
    )}
  </AuthView>
</PdfLayout>
