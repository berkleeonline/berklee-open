---
import { getEntries } from "../../lib/contentful";
import type { Unit } from "../../type/content-blocks";

import MainLayout from "../../layouts/authenticated.astro"
import AuthConditionalDisplayWrapper from '../../components/AuthConditionalDisplayWrapper';
import UnitCard from "../../components/cards/unit"
import FavoritesLoader from '../../components/account/favorites-loader';

const units = await getEntries('unit');
---

<MainLayout title={`Units`} cssClass="unit-index">
  <AuthConditionalDisplayWrapper showWhenAuth={true} client:load>
    <FavoritesLoader client:load />
  </AuthConditionalDisplayWrapper>
  <div class="flex gap-20">
    <div class="w-full">
      <h1 class="text-4xl font-bold mb-8">Units</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-3 gap-8">
        {units.map((unit, index) => (
          <UnitCard 
            key={unit.sys.id}
            id={unit.sys.id}
            title={unit.fields.unit_title}
            image={unit.fields.unit_image?.fields?.file?.url?.startsWith('//') 
              ? `https:${unit.fields.unit_image.fields.file.url}` 
              : unit.fields.unit_image?.fields?.file?.url}
            shortDescription={unit.fields.unit_short_description}
            level={unit.fields.unit_level || []}
            lessonsCount={unit.fields.unit_lessons?.length || 0}
            index={index}
            client:load
          />
        ))}
      </div>
    </div>
  </div>
</MainLayout>
