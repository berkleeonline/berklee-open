---
import { getEntries } from "../../lib/contentful";
import type { Lesson } from "../../type/content-blocks";

import MainLayout from "../../layouts/authenticated.astro";
import AuthConditionalDisplayWrapper from '../../components/AuthConditionalDisplayWrapper';
import LessonCard from "../../components/cards/lesson";
import FavoritesLoader from '../../components/account/favorites-loader';

const lessons = await getEntries('lesson');
---

<MainLayout title={`Lessons`} cssClass="lesson-index">
  <AuthConditionalDisplayWrapper showWhenAuth={true} client:load>
    <FavoritesLoader client:load />
  </AuthConditionalDisplayWrapper>
  <div class="flex gap-20">
    <div class="w-full">
      <h1 class="text-4xl font-bold mb-8">Lessons</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 2xl:grid-cols-3 gap-8">
        {lessons.map((lesson, index) => (
          <LessonCard 
            key={lesson.sys.id}
            id={lesson.sys.id}
            title={lesson.fields.lesson_title}
            duration={lesson.fields.lesson_duration}
            shortDescription={lesson.fields.lesson_short_description}
            audience={lesson.fields.lesson_audience}
            imageUrl={lesson.fields.lesson_image?.fields?.file?.url?.startsWith('//') 
              ? `https:${lesson.fields.lesson_image.fields.file.url}` 
              : lesson.fields.lesson_image?.fields?.file?.url}
            index={index}
            client:load
          />
        ))}
      </div>
    </div>
  </div>
</MainLayout>
