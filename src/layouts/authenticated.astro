---
import '@fontsource-variable/nunito-sans'; // Supports weights 200-900
import App from "../components/app";
import Header from "../components/header";
import Footer from "../components/footer";
import { ViewTransitions } from 'astro:transitions';
import type { HeaderProps } from "../type/layout";
import '../css/global.scss';
import '../fontAwesome'; // Font Awesome...obviously.
import AuthHandler from "../components/account/account-auth-handler";


// Define default values or handle optional properties
const { title = 'Berklee Open', cssClass } = Astro.props;
const showFooter = Astro.props.showFooter ?? true;
---
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8">
    <title>{title} | Berklee Open</title>
    <ViewTransitions />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class={cssClass + " authenticated"}>
    <App client:load>
      <AuthHandler client:load />
      <Header text={title} client:load />
      <main class={cssClass}>
        <div class="px-6 mx-auto w-full pt-16 pb-16 max-w-[1536px]" transition:animate="slide">
          <slot />
        </div>
      </main>
      {showFooter && <Footer />}
    </App>
  </body>
</html>
