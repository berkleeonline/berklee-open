---
import App from "../components/app";
import AuthHandler from "../components/account/account-auth-handler";
import '../css/global.scss';

interface Props {
  title: string;
  cssClass?: string;
  showHeader?: boolean;
}

const {
  title,
  cssClass,
  showHeader = false,
} = Astro.props;

---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class={cssClass}>
    <App client:load skipPasswordGate={true}>
      <AuthHandler client:load />
      <main>
        <slot />
      </main>
    </App>
  </body>
</html>
